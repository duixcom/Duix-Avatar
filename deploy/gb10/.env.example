# Paths are relative to deploy/gb10/docker-compose.yml unless made absolute.
DUIX_ASSETS_ROOT=./assets
DUIX_DATA_ROOT=./data
DUIX_CACHE_ROOT=./cache
DUIX_UID=1000
DUIX_GID=1000
# Local desktop clients use these loopback ports by default.
DUIX_VIDEO_PORT=8383
DUIX_TTS_PORT=18180

# Optional Ubuntu Ports mirror for image builds; empty keeps the official source.
DUIX_APT_MIRROR=
